---
---

<footer class="site-footer">
	<div class="site-footer__inner content-container">
		<nav aria-label="Footer navigation">
			<a href="/">Home</a>
		</nav>
		<p class="site-footer__visitor-count" data-visitor-count aria-live="polite">
			visitor count : unavailable
		</p>
	</div>
</footer>

<script>
	const countElement = document.querySelector<HTMLElement>('[data-visitor-count]');
	const cookieName = 'adi_kesava_visitor_count_v1';
	const counterKey = 'adi-kesava-perumal-temple-website-visitors';

	if (countElement) {
		const hasSessionCookie = document.cookie
			.split(';')
			.some((cookie) => cookie.trim().startsWith(`${cookieName}=`));

		if (!hasSessionCookie) {
			const secureAttribute = location.protocol === 'https:' ? '; Secure' : '';
			document.cookie = `${cookieName}=1; Path=/; SameSite=Lax${secureAttribute}`;
		}

		const operation = hasSessionCookie ? 'get' : 'hit';
		const endpoint = `https://countapi.mileshilliard.com/api/v1/${operation}/${counterKey}`;

		try {
			const response = await fetch(endpoint, { cache: 'no-store' });
			if (!response.ok) {
				throw new Error(`Count API returned HTTP ${response.status}`);
			}

			const payload: unknown = await response.json();
			if (
				typeof payload !== 'object' ||
				payload === null ||
				!('value' in payload) ||
				typeof payload.value !== 'number' ||
				!Number.isSafeInteger(payload.value) ||
				payload.value < 0
			) {
				throw new Error('Count API response did not contain a valid count.');
			}

			countElement.textContent = `visitor count : ${payload.value}`;
		} catch (error) {
			console.error('Unable to load visitor count.', error);
			countElement.textContent = 'visitor count : unavailable';
		}
	}
</script>

<style>
	.site-footer {
		border-top: 1px solid var(--colour-border);
		background: var(--colour-page-background);
		color: var(--colour-text);
	}

	.site-footer__inner {
		padding-block: 1rem;
	}

	.site-footer nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.site-footer a {
		display: inline-block;
		padding-block: 0.375rem;
		color: var(--colour-accent);
		font-size: 0.9375rem;
		line-height: 1.5;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.2em;
	}

	.site-footer__visitor-count {
		margin: 0.375rem 0 0;
		color: var(--colour-muted);
		font-size: 0.75rem;
		line-height: 1.5;
	}
</style>
